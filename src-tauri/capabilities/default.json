{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana de Game Fix: abrir WhatsApp, mensajes, correo y enlaces fuera del programa",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "sms:*"
        },
        {
          "url": "smsto:*"
        },
        {
          "url": "whatsapp:*"
        },
        {
          "url": "whatsapp://*"
        }
      ]
    }
  ]
}
